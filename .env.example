# SQLite база для локальной разработки без VPS/VDS
DATABASE_URL=file:./wakeparks-russia.db

# Используется для JWT/сессий Payload. В реальном проекте поставь длинную случайную строку.
PAYLOAD_SECRET=replace-with-long-random-secret

# Локальный адрес сайта. Без слеша в конце.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Секрет для cron/job эндпоинтов Payload
CRON_SECRET=replace-with-long-random-cron-secret

# Секрет для preview режима
PREVIEW_SECRET=replace-with-long-random-preview-secret

# Токен для локального импорта каталога через /data-tools.
# Пример: WAKE_ADMIN_TOKEN=change-me-local-import-token
WAKE_ADMIN_TOKEN=replace-with-local-import-token
